# PostgreSQL de Supabase (Project Settings > Database > URI)
# Usa el connection string "URI" con el password del proyecto.
DATABASE_URL="postgresql://postgres:your_password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?pgbouncer=true"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3000
FRONTEND_ORIGIN="*"
