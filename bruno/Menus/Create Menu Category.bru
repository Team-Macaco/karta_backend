meta {
  name: Create Menu Category
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/restaurants/{{restaurantId}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Bebidas y Aguas Frescas",
    "displayOrder": 1
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("categoryId", res.body.id);
  }
}
