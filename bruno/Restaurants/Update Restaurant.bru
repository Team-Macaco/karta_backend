meta {
  name: Update Restaurant
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/restaurants/{{restaurantId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
